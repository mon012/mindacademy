---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  bodyClass?: string;
  redirect?: string;
  jsonLd?: string[];
  indexable?: boolean;
}

const {
  title,
  description = 'Mind Academy ศูนย์การเรียนรู้สำหรับเด็กวัย 4-12 ปี',
  canonical,
  bodyClass = '',
  redirect,
  jsonLd = [],
  indexable = true,
} = Astro.props;
const pathname = Astro.url.pathname;
const productionOrigin = 'https://mindacademythai.com';
const absoluteCanonical = new URL(canonical || pathname, productionOrigin).href;
const mainLinks = [
  { href: '/classes/', label: 'หลักสูตร' },
  { href: '/articles/', label: 'บทความ' },
];
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!redirect && indexable && <link rel="canonical" href={absoluteCanonical} />}
    {!indexable && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/assets/wp-content/uploads/2024/09/MA320-150x150.webp" />
    {redirect && <meta http-equiv="refresh" content={`0;url=${redirect}`} />}
    {jsonLd.map((item) => <script type="application/ld+json" set:html={item} />)}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#content">ข้ามไปยังเนื้อหา</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Mind Academy หน้าหลัก">
        <img data-image-component="true" src="/assets/wp-content/uploads/2024/09/Mind-Academy-lgo.png" alt="Mind Academy" width="200" height="42" loading="eager" />
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-menu">
        <span>เมนู</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
      <nav id="primary-menu" aria-label="เมนูหลัก">
        {mainLinks.map((link) => (
          <a href={link.href} aria-current={pathname.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>
      <a class="header-action desktop-line-action" href="https://lin.ee/9AYoGQF" target="_blank" rel="noopener">
        <span>สอบถามข้อมูลเพิ่มเติม</span>
        <svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.5 10.2c0-4.1-3.8-7.4-8.5-7.4S3.5 6.1 3.5 10.2c0 3.7 3.3 6.8 7.7 7.3.3.1.7.2.8.4.1.2.1.6.1.8l-.1.8c0 .2-.2.9.8.5 1-.4 5.2-3.1 7.1-5.4 1.2-1.3 1.7-2.8 1.7-4.4Z" fill="currentColor"/>
          <path d="M8.2 8.1v4.3h2.5M11.6 8.1v4.3M13 8.1l2 2.8V8.1v4.3M19 8.1h-2.5v4.3H19M16.5 10.2h2" fill="none" stroke="#06c755" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.15"/>
        </svg>
      </a>
    </header>
    <a class="header-action floating-line-action" href="https://lin.ee/9AYoGQF" target="_blank" rel="noopener">
      <span>สอบถามข้อมูลเพิ่มเติม</span>
      <svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.5 10.2c0-4.1-3.8-7.4-8.5-7.4S3.5 6.1 3.5 10.2c0 3.7 3.3 6.8 7.7 7.3.3.1.7.2.8.4.1.2.1.6.1.8l-.1.8c0 .2-.2.9.8.5 1-.4 5.2-3.1 7.1-5.4 1.2-1.3 1.7-2.8 1.7-4.4Z" fill="currentColor"/>
        <path d="M8.2 8.1v4.3h2.5M11.6 8.1v4.3M13 8.1l2 2.8V8.1v4.3M19 8.1h-2.5v4.3H19M16.5 10.2h2" fill="none" stroke="#06c755" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.15"/>
      </svg>
    </a>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-brand">
        <img data-image-component="true" src="/assets/wp-content/uploads/2024/09/Mind-Academy-lgo.png" alt="Mind Academy" width="200" height="42" loading="lazy" />
        <p>© 2026 Mind Academy. All rights reserved.</p>
      </div>
      <div class="footer-links">
        <a href="/classes/sam/">Singapore Math</a>
        <a href="/classes/">Mind Classes</a>
        <a href="/articles/">Articles</a>
      </div>
      <div class="footer-contact">
        <a href="/contact/">Contact us</a>
        <a href="/privacy-policy/">Privacy Policy</a>
        <div class="social-links" aria-label="โซเชียลมีเดีย">
          <a href="https://www.facebook.com/mindacademythai" target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4.3c-.5-.1-2.1-.3-4-.3-3.9 0-6.6 2.4-6.6 6.8V14H2v4.7h4.4V24h5.4v-5.3h4.5L17 14h-5.2v-2.7C11.8 9.9 12.2 8 14 8Z" fill="currentColor"/></svg>
          </a>
          <a href="https://lin.ee/9AYoGQF" target="_blank" rel="noopener" aria-label="LINE">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 10.2c0-4.1-3.8-7.4-8.5-7.4S3.5 6.1 3.5 10.2c0 3.7 3.3 6.8 7.7 7.3.3.1.7.2.8.4.1.2.1.6.1.8l-.1.8c0 .2-.2.9.8.5 1-.4 5.2-3.1 7.1-5.4 1.2-1.3 1.7-2.8 1.7-4.4Z" fill="currentColor"/></svg>
          </a>
          <a href="https://www.youtube.com/@mindacademy9724" target="_blank" rel="noopener" aria-label="YouTube">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z" fill="currentColor"/></svg>
          </a>
        </div>
      </div>
    </footer>
    <script>
      document.querySelectorAll('a[target="_blank"]').forEach((link) => {
        const rel = new Set((link.getAttribute('rel') || '').split(/\s+/).filter(Boolean));
        rel.add('noopener');
        link.setAttribute('rel', [...rel].join(' '));
      });

      const menuToggle = document.querySelector('.menu-toggle');
      const primaryMenu = document.querySelector('#primary-menu');
      if (menuToggle && primaryMenu) {
        menuToggle.addEventListener('click', () => {
          const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
          menuToggle.setAttribute('aria-expanded', String(!isOpen));
          primaryMenu.classList.toggle('is-open', !isOpen);
        });
      }

      const navigator = document.querySelector('.octopus-navigator');
      if (navigator) {
        let navigatorIsVisible = false;
        const syncBubbleMotion = () => {
          navigator.classList.toggle('bubbles-active', navigatorIsVisible && !document.hidden);
        };
        const bubbleObserver = new IntersectionObserver(([entry]) => {
          navigatorIsVisible = entry.isIntersecting;
          syncBubbleMotion();
        }, { threshold: 0.15 });
        bubbleObserver.observe(navigator);
        document.addEventListener('visibilitychange', syncBubbleMotion);
      }

      const successSection = document.querySelector('.home .gb-container-713045d0');
      const missionSection = document.querySelector('.home .gb-container-1ec3fc59');
      const reelsSection = document.querySelector('.home .classroom-reels');
      if (successSection && reelsSection) successSection.before(reelsSection);
      const reelFrames = document.querySelectorAll('.classroom-reel iframe[data-src]');
      const reelLoader = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const frame = entry.target;
          frame.src = frame.dataset.src;
          frame.removeAttribute('data-src');
          observer.unobserve(frame);
        });
      }, { rootMargin: '500px 0px' });
      reelFrames.forEach((frame) => reelLoader.observe(frame));
  if (successSection && missionSection) {
        const storyTrack = successSection.querySelector('.gb-grid-wrapper');
        const bangnaVideo = successSection.querySelector(':scope > .gb-container > .wp-block-embed');
        const missionColumns = missionSection.querySelectorAll('.gb-grid-column');
        const missionMedia = missionColumns[1]?.querySelector('.gb-container');

        storyTrack?.classList.add('success-stories-track');
        successSection.setAttribute('aria-label', 'Success Stories เลื่อนซ้ายขวาเพื่อดูคลิป');

    if (bangnaVideo && missionMedia) {
      missionMedia.append(bangnaVideo);
      missionColumns[1].classList.add('mission-media');
      missionColumns[0]?.classList.add('mission-copy');
    }

    missionSection.querySelector('.gb-button-4c8be7a7')?.remove();
  }

      const oceanDetails = [
        ['.home .gb-container-718388c8', 'fish', '<svg viewBox="0 0 150 72" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M13 27c13-14 31-14 44 0-13 14-31 14-44 0Zm0 0L2 17v20l11-10Zm52 13c9-10 22-10 31 0-9 10-22 10-31 0Zm0 0-8-8v16l8-8Zm46-20c7-8 18-8 25 0-7 8-18 8-25 0Zm0 0-7-6v12l7-6Z"/><circle cx="49" cy="24" r="1" fill="currentColor" stroke="none"/><circle cx="90" cy="38" r="1" fill="currentColor" stroke="none"/><circle cx="131" cy="18" r="1" fill="currentColor" stroke="none"/></g></svg>'],
        ['.home .gb-container-713045d0', 'bubbles', '<svg viewBox="0 0 110 130" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2"><circle cx="35" cy="96" r="13"/><circle cx="72" cy="65" r="9"/><circle cx="43" cy="37" r="6"/><circle cx="82" cy="19" r="3"/><path d="M28 91c2-4 5-6 9-7M67 61c2-2 4-3 6-3" stroke-linecap="round"/></g></svg>'],
        ['.home .gb-container-1ec3fc59', 'starfish', '<svg viewBox="0 0 110 110" aria-hidden="true"><path d="m55 9 11 29 31-8-24 22 20 25-30-11-8 32-8-32-30 11 20-25-24-22 31 8L55 9Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="2"/><circle cx="55" cy="53" r="5" fill="none" stroke="currentColor" stroke-width="2"/></svg>'],
      ];
      oceanDetails.forEach(([selector, kind, artwork]) => {
        const section = document.querySelector(selector);
        if (!section || section.querySelector(`.ocean-detail--${kind}`)) return;
        const detail = document.createElement('span');
        detail.className = `ocean-detail ocean-detail--${kind}`;
        detail.setAttribute('aria-hidden', 'true');
        detail.innerHTML = artwork;
        section.append(detail);
      });
    </script>
  </body>
</html>
